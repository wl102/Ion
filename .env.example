# ============================================================
# LLM API Configuration
# ============================================================

# Model identifier using litellm's provider/model format.
# Examples:
#   openai/gpt-4o
#   anthropic/claude-3-5-sonnet-20240620
#   deepseek/deepseek-chat
#   azure/gpt-4o
#   gemini/gemini-1.5-pro
#   ollama/llama3
# If the provider prefix is omitted, litellm will try to infer it from other
# settings (e.g. base_url, env vars).
MODEL_ID = "openai/gpt-4o"

# OpenAI-compatible API base URL.
# Required when using an OpenAI-compatible proxy or local inference server
# (e.g. DeepSeek, MiniMax, vLLM, Ollama with open-webui, etc.).
# For native provider APIs (Anthropic, Gemini, Bedrock, etc.) you can leave
# this empty — litellm uses the provider's official endpoint automatically.
API_BASE = "https://api.openai.com/v1"

# API key for authentication.
# For OpenAI-compatible endpoints: use the key required by that endpoint.
# For native provider APIs: you can EITHER set this variable OR use the
# provider-specific environment variable (e.g. ANTHROPIC_API_KEY,
# GEMINI_API_KEY, AZURE_API_KEY, etc.). litellm reads the provider-specific
# vars automatically when the matching provider prefix is used in MODEL_ID.
API_KEY = "sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Whether the model supports vision/image input (e.g., gpt-4o, claude-sonnet-4-6).
# Set to "true" if you want browser screenshot actions to be sent as images
# in the conversation instead of returning only file paths.
MODEL_SUPPORTS_VISION = false

# ============================================================
# Agent Loop Control
# ============================================================

# Maximum turns for the main agent loop (0 = unlimited)
AGENT_MAX_LOOP = 100

# Maximum turns for sub-agent delegation (used via Budget.max_turns, not an env var)
SUB_AGENT_MAX_LOOP = 50

# Context window token threshold; when exceeded, older history is compressed (0 = disabled)
CONTEXT_MAX_TOKENS = 128000

# ============================================================
# Persistence & Logging
# ============================================================

# Directory for session observability logs (.jsonl files)
# If omitted, defaults to ~/.ion/logs
ION_LOG_DIR = "./logs"

# Database connection URL.
# Default (when unset): sqlite database at ~/.ion/ion.db.
# Set below to a relative path to place ion.db next to docker-compose.yaml (project root).
# WARNING: SQLite URLs use 3 slashes for relative paths and 4 slashes for absolute paths.
#   Relative: sqlite:///ion.db
#   Absolute: sqlite:////absolute/path/to/ion.db
#   Wrong:    sqlite:///~/.ion/ion.db   (SQLite does NOT expand ~)
# MySQL:    mysql+pymysql://user:pass@localhost/ion
# PostgreSQL: postgresql://user:pass@localhost/ion
ION_DATABASE_URL = "sqlite:///ion.db"

# ============================================================
# Tool Configuration
# ============================================================

# Unified tool execution timeout (seconds). Applies to all tool handlers including bash.
TOOL_EXEC_TIMEOUT = 600

# ============================================================
# Web Server
# ============================================================

# Port for the Ion Web API (uvicorn) and the docker-compose host port mapping.
ION_PORT = 8000
